# /etc/hy2-ops-console/api.env
#
# 宿主机（非 Docker）部署时的环境变量文件模板。
# 安装：sudo install -m 600 -o nodeops -g nodeops deploy/api.env.example /etc/hy2-ops-console/api.env
#
# 和根目录 .env.example 的区别：这里是给 systemd 直接读的纯 KEY=VALUE，
# 不带编排文件的 ${VAR:-default} 语法，也不引用容器服务名（db → 真实主机地址）。

# ---- 基础服务与数据库 ------------------------------------------------------
# 监听端口。生产建议保持 8080，前面用 Caddy/Nginx 反代到 443。
PORT=8080

# 数据库连接串。同机部署通常是 127.0.0.1；密码请使用 URL 安全随机串：
#   openssl rand -base64 36 | tr '+/' '-_' | tr -d '=\n'
# 用 Unix 套接字也可以：postgres:///nodeops?host=/var/run/postgresql
DATABASE_URL=postgres://nodeops:CHANGE_ME@127.0.0.1:5432/nodeops?sslmode=disable

# 允许跨域的前端来源，逗号分隔（同源反代部署通常保持面板域名即可）。
ALLOWED_ORIGIN=https://panel.example.com

# ---- 认证、密钥与反代边界 --------------------------------------------------
# JWT 签名密钥，≥32 字符。生成：openssl rand -base64 48
JWT_SECRET=CHANGE_ME
# 会话令牌有效期（分钟），默认 720（12 小时）。
# JWT_TTL_MINUTES=720

# 初始管理员（仅首次启动插入；密码 ≥12 字符）
SEED_ADMIN_EMAIL=admin@example.invalid
SEED_ADMIN_PASSWORD=CHANGE_ME

# 节点 SSH 凭据加密密钥，必须是标准 base64 编码的 32 字节随机数。
# 生成：openssl rand -base64 32
# ⚠️ 有凭据入库后不可更改
CREDENTIAL_KEY=CHANGE_ME

# 允许采信 X-Forwarded-For 的可信反向代理网段（逗号或空格分隔 CIDR，留空则仅信任直连对端地址）。
# 本机 Caddy 反代部署时建议设为 127.0.0.1/32,::1/128
TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128

# 是否限制只读角色（viewer）读取订阅交付凭证（默认 false 保持兼容，设为 true 返回 403）。
# VIEWER_RESTRICT_SUBSCRIPTIONS=false

# 自签节点门户证书指纹固定（JSON 对象，按 host:port 或 hostname 映射 SHA256 十六进制）。
# PORTAL_TLS_PINS={"node.example.com:8443":"CERTIFICATE_SHA256_HEX"}

# ---- 采集、执行与测速 ------------------------------------------------------
# 开启 SSH 采集器（生产建议 true，否则面板数据不刷新）
ENABLE_COLLECTOR=true
# 采集器轮询间隔（秒），默认 30
# COLLECTOR_INTERVAL_SECONDS=30
# 任务执行器轮询间隔（秒），默认 20
EXECUTOR_INTERVAL_SECONDS=20
# 周期性三网测速间隔（分钟），默认 15；设为 0 禁用周期测速
# SPEEDTEST_INTERVAL_MINUTES=15

# ---- 外部地址、人机验证与可选联动 ------------------------------------------
# 控制台外部访问地址（用于 Telegram 告警与菜单跳转按钮）
# PANEL_PUBLIC_URL=https://panel.example.com
# 发给买家的订阅与交付链接域名（留空则按请求域名推导）
# SUBSCRIPTION_PUBLIC_BASE_URL=
# 备用订阅域名（逗号分隔，可选）
# SUBSCRIPTION_BACKUP_BASE_URLS=
# 客户端导入后的默认订阅分组名（默认 Teyir，也可在界面系统设置覆盖）
SUBSCRIPTION_DEFAULT_NAME=Teyir
# 外部商城续费基础地址（可选，例如 https://shop.example.com/）
# STORE_RENEW_BASE_URL=

# Cloudflare Turnstile 登录人机验证（两项同时配置时启用）
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET=
# 内部自动化登录豁免密钥（至少 32 字符）及绑定账号邮箱（留空默认仅限种子管理员）
# LOGIN_SERVICE_KEY=
# LOGIN_SERVICE_EMAIL=

# 宿主机封禁联动接口地址与令牌（可选，供 Telegram 机器人封禁管理使用）
# BAN_WEBHOOK_URL=http://127.0.0.1:8098
# BAN_WEBHOOK_TOKEN=

# 一键安装节点脚本地址（HTTPS）及节点门户更新来源仓库（格式 owner/repo）
# HY2_INSTALL_SCRIPT_URL=https://raw.githubusercontent.com/your-org/hysteria2-installer/main/install.sh
# HY2_INSTALLER_REPO=your-org/hysteria2-installer

# ---- 地区与 IP 纯净度识别（可选） ------------------------------------------
# GEO_OFFLINE_DB=/opt/hy2-ops-console/geo-data/geo-offline.json
# GEO_ENABLE_API=true
# GEO_API_BASE_URL=
# IP_PURITY_OFFLINE_DB=
# IP_PURITY_API_KEY=
# IP_PURITY_IPQS_KEY=
# IP_PURITY_API_BASE_URL=
