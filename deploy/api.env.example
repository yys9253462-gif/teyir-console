# /etc/hy2-ops-console/api.env
#
# 宿主机（非 Docker）部署时的环境变量文件。
# 安装：sudo install -m 600 -o nodeops -g nodeops api.env /etc/hy2-ops-console/api.env
#
# 和 .env.example 的区别：这里是给 systemd 直接读的纯 KEY=VALUE，
# 不带 compose 的 ${VAR:-default} 语法，也不引用容器服务名（db → 真实主机地址）。

# 监听端口。生产建议保持 8080，前面用 Caddy/Nginx 反代到 443。
PORT=8080

# 数据库连接串。同机部署通常是 localhost；
# 用 Unix socket 也可以：postgres:///nodeops?host=/var/run/postgresql
DATABASE_URL=postgres://nodeops:CHANGE_ME@127.0.0.1:5432/nodeops?sslmode=disable

# 允许跨域的前端来源，逗号分隔。
ALLOWED_ORIGIN=https://panel.example.com

# JWT 签名密钥，≥32 字符。生成：openssl rand -base64 48
JWT_SECRET=CHANGE_ME

# 初始管理员（仅首次启动插入）
SEED_ADMIN_EMAIL=admin@example.invalid
SEED_ADMIN_PASSWORD=CHANGE_ME

# 节点 SSH 凭据加密密钥，32 字节 base64。生成：openssl rand -base64 32
# ⚠️ 有凭据入库后不可更改
CREDENTIAL_KEY=CHANGE_ME

# 开启 SSH 采集器（生产建议 true，否则面板数据不刷新）
ENABLE_COLLECTOR=true

# 任务执行器轮询间隔（秒）
EXECUTOR_INTERVAL_SECONDS=20
