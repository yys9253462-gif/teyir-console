# ============================================================================
# teyir-console 环境变量模板
# 复制成 .env 后填入真实值：cp .env.example .env
# .env 已被 .gitignore 忽略，不会被提交。
# ============================================================================

# ---- 数据库 ----------------------------------------------------------------
# 必填。Postgres 超级用户密码，建议 32 位以上 URL 安全随机串（避免含 + / = 破坏连接串解析）。
# 生成：openssl rand -base64 36 | tr '+/' '-_' | tr -d '=\n'
POSTGRES_PASSWORD=replace-with-a-long-random-value

# ---- 认证与会话 ------------------------------------------------------------
# 必填。JWT 签名密钥，至少 32 字符。
# 生成：openssl rand -base64 48
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
# 可选。会话令牌有效期（分钟），默认 720（12 小时，范围 1–1440）。
# JWT_TTL_MINUTES=720

# 必填。首次启动时创建的初始管理员账号。
SEED_ADMIN_EMAIL=admin@example.invalid
SEED_ADMIN_PASSWORD=replace-with-a-unique-long-password

# 必填。节点 SSH 凭据的 AES-256-GCM 加密密钥，必须是 32 字节的 base64。
# 生成：openssl rand -base64 32
# ⚠️ 一旦有节点凭据入库，这个值就不能再改——改了旧凭据全部解不开。
CREDENTIAL_KEY=base64-of-32-random-bytes

# ---- 访问控制 --------------------------------------------------------------
# 允许跨域访问 API 的来源，多个用英文逗号分隔。
# 走同源部署（web 服务转发 /api）时其实用不到 CORS，留默认值即可；
# 只有前端部署在别的域名时才需要把那个域名加进来。
ALLOWED_ORIGIN=http://localhost:5173

# ---- 服务端口 --------------------------------------------------------------
# API 容器内部固定监听 8080，这里指的是映射到宿主机的端口。
# 默认只绑在 127.0.0.1：外部访问统一走 web 服务，直连 API 仅用于本机调试。
API_BIND=127.0.0.1
API_PORT=8080

# web 服务的监听端口。
# 默认只绑 127.0.0.1（前面有一层外层反代时最安全，也避免无证书直接暴露明文管理面板）。
# 面板直接对外提供服务（自己申领证书、监听 80/443）时请显式改成 0.0.0.0。
WEB_BIND=127.0.0.1
WEB_PORT=80
WEB_TLS_PORT=443

# ---- 站点与 TLS ------------------------------------------------------------
# 留空（也就是把这一行整个注释掉）→ web 服务监听 :80，用 HTTP 访问
# （本地 / 内网 / 外层已有反代时这样）。
# 填域名 → 自动向 Let's Encrypt 申领证书并监听 :443。
#   例：SITE_ADDRESS=panel.example.com
# 前提：该域名已解析到本机，且 80/443 对公网可达（ACME 校验需要）。
#
# ⚠️ 想「留空」必须注释掉本行，不能写成 `SITE_ADDRESS=`。
#
# 原因是 compose 里写的是不带值的 `- SITE_ADDRESS`（「宿主有该变量才注入」），
# 而 docker compose 会自动读取同目录的 .env —— 写成空值时，变量对容器而言
# 依然是「存在但为空」，于是 Caddy 收到的站点地址是空字符串，不会回退默认值，
# 启动直接报：
#   Error: adapting config using caddyfile: server block without any key
#   is global configuration, and if used, it must be first
# 并陷入 restart 循环（实测 cp .env.example .env 后照原样启动就会踩到）。
#
# ⚠️ 另外，多个随机值不要用 `openssl rand -base64` 的默认字符集：
# 它会产生 `+` `/` `=`。POSTGRES_PASSWORD 会被拼进
# `postgres://nodeops:<密码>@db:5432/nodeops`，其中的 `+` 会被 URL 解析器
# 当成端口分隔符，报 `invalid port ... after host`，迁移直接失败。
# 生成后请把非 URL 安全字符换掉，例如：
#   openssl rand -base64 36 | tr '+/' '-_' | tr -d '=\n'
# 但注意 CREDENTIAL_KEY 例外：它由 Go 的 base64.StdEncoding 解码，
# **必须**是标准 base64（含 `+` `/`），不能用 base64url 的 `-` `_`，
# 否则报 `CREDENTIAL_KEY must be base64: illegal base64 data`。
# 这两个要求方向相反，别用同一条命令生成。
#
# SITE_ADDRESS=

# ---- 采集与执行 ------------------------------------------------------------
# 是否启用 SSH 采集器。开启后按周期轮询所有已登记节点，刷新监控数据；
# 关闭则面板只有存量数据。生产环境建议 true。
ENABLE_COLLECTOR=false

# 采集器轮询间隔（秒），默认 30（范围 1–3600）。
# COLLECTOR_INTERVAL_SECONDS=30

# 任务执行器轮询间隔（秒），决定下发的重启/配置变更等操作多久被拾取。
EXECUTOR_INTERVAL_SECONDS=20

# 周期性三网测速间隔（分钟），默认 15；显式设为 0 表示禁用周期测速（手动触发仍可用）。
# SPEEDTEST_INTERVAL_MINUTES=15

# ---- 迁移（一般不用动） ----------------------------------------------------
# 迁移文件目录，默认 server/migrations。
# MIGRATIONS_DIR=server/migrations
#
# 仅用于「迁移器出现之前就存在的老库」这一种情况：
#   这类库的表结构是完整的，但没有 schema_migrations 台账记录。
#   默认（未设置或 false）检测到老库时会自动把现有文件登记为 baseline 而不重放。
#   设为 true 会关闭自动登记基线行为，强制按文件重放全部迁移（危险，仅限排障）。
# MIGRATE_ASSUME_BASELINE=false

# ---- 地区 / VPS 商家自动识别 ------------------------------------------------
#
# 作用：新增 hy2 节点、或登记 3X-UI 面板时，按它的公网 IP 自动认出
# 「在哪个地区、是哪家 VPS 商家」，并据此命名（如 `日本-东京`）。
#
# 三条行为约定（改之前请先读 server/internal/httpapi/geoapply.go 与 server/internal/geo/geo.go）：
#   1. 命名格式是 `国家-城市`（商家信息单独记录在 provider 字段）；只有一边识别出来时就只用那一边
#   2. **已经手工填过的字段永远不覆盖** —— 你打的 `HK-主力` 不会被冲掉
#   3. 识别不出来（没库、没网、内网 IP）时什么都不改，让你手填
#
# 离线库路径（容器内视角）。库由 tools/gen_offline_db.py 生成后，
# 让宿主 `geo-data/geo-offline.json` 与它对应即可（compose 已把
# 宿主 ./geo-data 挂到容器 /data）。文件不存在只会记一条 WARN，
# 服务照常工作 —— 识别是加分项，不是启动前置条件。
GEO_OFFLINE_DB=/data/geo-offline.json

# 离线库查不到时，是否允许调用公网 geo API（默认 ip-api.com）。
# 置 false 则**完全不联网识别**，适合严格内网部署。
#
# ⚠️ 关于隐私与合规，两条要知道的：
#   - 调用公网 API 意味着把「我这台机器的 IP」发给第三方。单次无感，
#     但批量识别等价于交出一份服务器清单。在意隐私就配离线库。
#   - ip-api.com 的**免费版仅允许非商业用途**。商业运营请购买其付费
#     端点（用 GEO_API_BASE_URL 指过去），或改用自备数据源生成离线库。
GEO_ENABLE_API=true

# 覆盖兜底 API 的地址。留空用默认（http://ip-api.com/json）。
# 例：换成自建服务或付费端点时填这里。
# GEO_API_BASE_URL=

# ── IP 纯净度检测（节点 IP 干不干净）─────────────────────────────────
#
# 输入一个节点的公网 IP，输出：连接类型（家宽/机房/移动/专线）、
# 是否双 ISP、纯净度风险评分（0-100，越大越脏）。
#
# 与 geo 同样是「离线优先、公网 API 兜底」：离线库能给连接类型，
# 但评分与双 ISP 只有第三方 API 才给得出。**密钥留空即整块功能关闭**
# （端点返回明确的「未启用」，节点其余功能不受影响）。
#
# 离线判定库路径（容器内视角）。格式见 ippurity 包注释。
# 可选 —— 不配则每次检测都要出网。
# IP_PURITY_OFFLINE_DB=/data/ip-purity-offline.json
#
# 第三方 API 密钥（默认对接 ipapi.is）。**自己去 https://ipapi.is 注册后填这里。**
# 免费额度 1000 次/天；结果会落库缓存，不重复查同一台机器。
# IP_PURITY_API_KEY=
#
# 可选：IPQualityScore 密钥（用于单 IP 欺诈风险评分，也可在控制台系统设置中填写）。
# IP_PURITY_IPQS_KEY=
#
# 覆盖第三方 API 地址。留空用默认 https://api.ipapi.is。
# IP_PURITY_API_BASE_URL=

# 默认验证 CA。自签门户仅在显式绑定证书 SHA256 后信任（可按 host:port 或 hostname 登记）。
# PORTAL_TLS_PINS={"node.example.com:8443":"CERTIFICATE_SHA256_HEX"}
PORTAL_TLS_PINS=

# ── 反代与角色边界（默认安全关闭）──────────────────────────────────────────
#
# TRUSTED_PROXY_CIDRS：声明「允许携带 X-Forwarded-For 的对端」。
# 当面板 API 前部署了反向代理（单层或多层反代）时，只有显式登记的代理网段
# 写下的转发头才会被采信；未登记时一律使用直连对端地址（防伪造）。
# 逗号或空格分隔的 CIDR；单 IP 需写成 /32（IPv6 写成 /128）。
# 部署示例：
#   TRUSTED_PROXY_CIDRS=172.18.0.0/16,127.0.0.1/32,::1/128
# TRUSTED_PROXY_CIDRS=

# VIEWER_RESTRICT_SUBSCRIPTIONS：只读角色（viewer）默认保持兼容；
# 若不希望 viewer 读取订阅交付凭证，设为 true 可在订阅接口返回 403。
# VIEWER_RESTRICT_SUBSCRIPTIONS=false

# ── 外部地址与可选联动配置（按需填写，留空则对应外部跳转自动降级）─────────────
# 面板外部访问地址（用于 Telegram 告警与控制菜单跳转按钮）
# PANEL_PUBLIC_URL=https://panel.example.com

# 发给买家的订阅 / 交付链接域名（留空则按当前请求域名推导）
SUBSCRIPTION_PUBLIC_BASE_URL=

# 备用订阅域名（逗号分隔，可选）
# SUBSCRIPTION_BACKUP_BASE_URLS=https://sub2.example.com

# 客户端导入订阅后的默认分组名称（也可在系统设置页面动态修改）
SUBSCRIPTION_DEFAULT_NAME=Teyir

# 外部商城续费基础地址（可选，配置后交付页与商城接口会拼接续费链接）
# STORE_RENEW_BASE_URL=https://shop.example.com/

# Cloudflare Turnstile 登录人机验证（两项同时配置时启用）
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET=
#
# 可选：自动化服务账号登录豁免密钥（≥32 字符）与允许豁免的邮箱（留空则仅限 SEED_ADMIN_EMAIL）
# LOGIN_SERVICE_KEY=
# LOGIN_SERVICE_EMAIL=

# 可选：宿主机封禁联动 Webhook 服务地址与共享口令（供 Telegram 机器人封禁管理使用）
# BAN_WEBHOOK_URL=http://127.0.0.1:8098
# BAN_WEBHOOK_TOKEN=replace-with-random-ban-webhook-token

# 可选：一键安装节点脚本地址（HTTPS）与节点门户批量更新来源仓库（格式 owner/repo）
# HY2_INSTALL_SCRIPT_URL=https://raw.githubusercontent.com/your-org/hysteria2-installer/main/install.sh
# HY2_INSTALLER_REPO=your-org/hysteria2-installer

# ---- 容器编排隔离（单实例留空即可，多实例或接入已有反代网络时按需设置） ----
# 编排项目名（隔离容器名、卷名与本地镜像标签）
# COMPOSE_PROJECT_NAME=teyir-console
# 接入网络名称（留空默认 teyir-console-internal）
# WEB_INGRESS_NETWORK=teyir-console-internal
